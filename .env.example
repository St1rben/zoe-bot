# Обов'язкові
BOT_TOKEN=123456:AAAA-your-token
CHAT_ID=-1001234567890

# Черга за замовчуванням (для чатів, що не обирали свою)
QUEUE=5.1

# Інтервал перевірки сторінки, секунд
CHECK_INTERVAL=60

# HTTP-сервер для health-check (хостинг задає PORT сам)
PORT=8080

# Деталізація логів: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Файл стану (SQLite)
STATE_DB=state.db

# Запити до zoe.com.ua: таймаут і кількість спроб
REQUEST_TIMEOUT=15
RETRY_ATTEMPTS=3

# Щоденне нагадування про графік (порожньо = вимкнено), напр. 20:00
DIGEST_TIME=
DIGEST_TZ=Europe/Kyiv

# DRY_RUN=1 — нічого не надсилати, лише писати в лог
DRY_RUN=0
